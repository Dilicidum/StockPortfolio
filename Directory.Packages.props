<Project>

  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- Versions verified against nuget.org on 2026-08-02. No floating ranges. -->

  <ItemGroup Label="Domain / Application">
    <PackageVersion Include="OneOf" Version="3.0.271" />
    <PackageVersion Include="FluentValidation" Version="12.1.1" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Api layer">
    <PackageVersion Include="FluentValidation.DependencyInjectionExtensions" Version="12.1.1" />
  </ItemGroup>

  <ItemGroup Label="Infrastructure">
    <PackageVersion Include="Microsoft.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    <!-- The EF store for ASP.NET Core Identity. Despite the Microsoft.AspNetCore prefix it is a
         data-access library: its own dependencies are EntityFrameworkCore.Relational and
         Microsoft.Extensions.Identity.Stores, and it pulls in no web framework. That is why
         LayerReferenceTests allows this one name through rule 4. -->
    <PackageVersion Include="Microsoft.AspNetCore.Identity.EntityFrameworkCore" Version="10.0.10" />
    <PackageVersion Include="StackExchange.Redis" Version="3.1.0" />
    <!-- Phase 3. Verified against nuget.org on 2026-08-05. 10.8.0 is the dotnet/extensions train
         (same as TimeProvider.Testing below), NOT the 10.0.10 runtime train — two release lines,
         both current. -->
    <PackageVersion Include="Microsoft.Extensions.Http" Version="10.0.10" />
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.8.0" />
    <!-- Phase 4. BackgroundService and AddHostedService live here. Pinned for the same reason as the line
         above: it arrives transitively through Microsoft.Extensions.Http.Resilience, so without this the
         quote poller compiles against whatever that package's graph happens to resolve. -->
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Host">
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Transitive pin: AspNetCore.OpenApi 10.0.10 pulls Microsoft.OpenApi 2.0.0, which
         carries a high-severity advisory (GHSA-v5pm-xwqc-g5wc). Stay on 2.x: 3.x makes
         IOpenApiMediaType.Example read-only and the AspNetCore OpenAPI source generator
         still assigns to it (CS0200). Transitive pinning is on,
         so naming it here upgrades it everywhere. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.11.0" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <PackageVersion Include="Scrutor" Version="7.0.0" />
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.10" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.8.1" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.10" />
    <PackageVersion Include="Testcontainers.PostgreSql" Version="4.13.0" />
    <PackageVersion Include="Testcontainers.Redis" Version="4.13.0" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.8.0" />
    <PackageVersion Include="Shouldly" Version="4.3.0" />
  </ItemGroup>

  <!--
    OneOfDiagnosticSuppressor is NOT here: it does not exist on nuget.org.
    docs/plan/00-overview.md listed it in the verified stack; that was wrong.
    Exhaustiveness is instead guaranteed structurally - see the note in
    Directory.Build.props and docs/plan/phase-1-implementation.md §3.

    OneOf.SourceGenerator was a GlobalPackageReference here and is gone too:
    it only does anything for [GenerateOneOf], which appears zero times because
    handlers return OneOf<...> directly. Reintroduce it with the attribute, not before.
  -->

</Project>
