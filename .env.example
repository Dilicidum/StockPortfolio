# =============================================================================
#  StockPortfolio - environment template
# =============================================================================
#  You do NOT need this file to run the stack. Every variable below has an
#  inline default in docker-compose.yml, so `docker compose up --build` works
#  from a clean clone with no configuration at all. Copy it only when you want
#  to override something:
#
#      cp .env.example .env
#
#  .env is gitignored. NEVER commit real credentials, and never reuse any value
#  below outside a local container - these are placeholders, published in the
#  repository, and must be treated as public.
# =============================================================================


# --- Postgres superuser (the container's own bootstrap account) --------------
# Used by the image entrypoint and by db/init/00-roles.sh to create the roles.
# No application ever connects with it.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_only
POSTGRES_DB=stockportfolio


# --- Module roles ------------------------------------------------------------
# One login role per module plus the migration role. Created by
# db/init/01-roles.sql; each service role has DML on its own schema only, and a
# cross-schema read fails with SQLSTATE 42501.
#
#   migrator        owns identity, portfolio, marketdata, alerts - migrations only
#   identity_svc    DML on identity.*
#   portfolio_svc   DML on portfolio.*
#   marketdata_svc  DML on marketdata.*
#   alerts_svc      DML on alerts.*
MIGRATOR_PW=migrator_dev_only
IDENTITY_PW=identity_dev_only
PORTFOLIO_PW=portfolio_dev_only
MARKETDATA_PW=marketdata_dev_only
ALERTS_PW=alerts_dev_only


# --- JWT ---------------------------------------------------------------------
# JWT_SIGNING_KEY must be at least 32 bytes; the API fails fast at startup if it
# is shorter or missing, rather than at the first login. Generate a real one
# with:  openssl rand -base64 48
JWT_ISSUER=https://stockportfolio.local
JWT_AUDIENCE=https://stockportfolio.local
JWT_SIGNING_KEY=dev-only-signing-key-change-me-0123456789abcdef


# --- Market data -------------------------------------------------------------
# Leave EMPTY. With no key the app uses FakeQuoteProvider and logs a warning -
# deliberate, because Finnhub killed its sandbox in 2022 and the demo has to
# work without a key. Set it only to exercise the real provider.
FINNHUB_API_KEY=

# Whether a signed-in user may bring their own provider key (POST/GET/DELETE
# /api/settings/api-key). A real value, not a placeholder - true is what ships.
BYOK_ENABLED=true


# --- Host ports --------------------------------------------------------------
# Change these if something already owns the port. WEB_PORT is where the app is
# served; the rest are for direct access and only published by
# docker-compose.override.yml.
WEB_PORT=5173
API_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379


# --- API runtime -------------------------------------------------------------
# docker-compose.override.yml defaults this to Development. Set Production to
# get the deployed shape locally (no /openapi, no exception detail).
ASPNETCORE_ENVIRONMENT=Development
LOG_LEVEL=Information
# Only needed when a browser calls the API on :8080 directly instead of going
# through the nginx proxy on :5173.
CORS_ORIGIN_0=http://localhost:5173
