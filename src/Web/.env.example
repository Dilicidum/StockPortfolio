# Copy to .env.local for `npm run dev`. Every value here is baked in at BUILD time.

# Public path the SPA is served from.
#   docker compose (nginx at "/")  -> leave unset
#   GitHub Pages ("/<repo>/")      -> VITE_BASE=/tickerzone/
# Consumed by vite.config.ts; the router basepath follows import.meta.env.BASE_URL.
# VITE_BASE=/

# Origin of the API.
#   docker compose  -> leave empty, "/api/*" is proxied by nginx (same origin)
#   GitHub Pages    -> https://<your-aca-app>.azurecontainerapps.io
# Empty means "same origin", which is what the compose stack wants.
VITE_API_BASE_URL=

# `npm run dev` only: where Vite proxies /api to. Not used in a build.
VITE_DEV_API_PROXY=http://localhost:8080
