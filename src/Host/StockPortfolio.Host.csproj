<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <UserSecretsId>stockportfolio-api</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <!-- Never published: it carries the local signing key and connection strings, and shipping it
         into the image means the "not configured" guards can never fire in a Development container. -->
    <Content Update="appsettings.Development.json" CopyToPublishDirectory="Never" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" PrivateAssets="all" />
    <PackageReference Include="StackExchange.Redis" />
    <PackageReference Include="AspNetCore.HealthChecks.Redis" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.StackExchangeRedis" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Modules\Identity\StockPortfolio.Modules.Identity.Infrastructure\StockPortfolio.Modules.Identity.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Portfolio\StockPortfolio.Modules.Portfolio.Infrastructure\StockPortfolio.Modules.Portfolio.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\MarketData\StockPortfolio.Modules.MarketData.Infrastructure\StockPortfolio.Modules.MarketData.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Alerts\StockPortfolio.Modules.Alerts.Infrastructure\StockPortfolio.Modules.Alerts.Infrastructure.csproj" />
    <ProjectReference Include="..\Modules\Identity\StockPortfolio.Modules.Identity.Api\StockPortfolio.Modules.Identity.Api.csproj" />
    <ProjectReference Include="..\Modules\Portfolio\StockPortfolio.Modules.Portfolio.Api\StockPortfolio.Modules.Portfolio.Api.csproj" />
    <ProjectReference Include="..\Modules\MarketData\StockPortfolio.Modules.MarketData.Api\StockPortfolio.Modules.MarketData.Api.csproj" />
    <ProjectReference Include="..\Modules\Alerts\StockPortfolio.Modules.Alerts.Api\StockPortfolio.Modules.Alerts.Api.csproj" />
  </ItemGroup>

</Project>
